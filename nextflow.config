/*
 * nf-16s-guarded — configuracion base.
 *
 * Regla de la casa: ninguna guarda tiene defecto permisivo. Los parametros que
 * gobiernan una guarda nacen en null a proposito; main.nf se para y lo dice si
 * llegan vacios. Lo que SI tiene valor fijo son las versiones: ni una etiqueta
 * movil, ni un :latest.
 */

manifest {
    name            = 'nf-16s-guarded'
    description     = 'Amplicon 16S: descarga verificada, control de calidad y perfilado taxonomico, con cada guarda probada por ataque'
    version         = '0.1.0'
    mainScript      = 'main.nf'
    license         = 'MIT'
    nextflowVersion = '>=24.04.0'
}

params {
    // --- guardas: sin defecto, a proposito -----------------------------------
    samplesheet   = null
    outdir        = null
    etapa         = null   // 'completa' | 'preparacion'
    reference_dir = null

    min_reads         = null   // puerta de calidad, en PARES de lecturas
    fastp_min_length  = null   // longitud minima que conserva fastp
    fastp_min_quality = null   // calidad Phred minima por base
    kraken_confidence = null   // 0 es el defecto de kraken2, y es permisivo

    // --- versiones fijadas ---------------------------------------------------
    // Comprobadas contra el registro antes de escribirlas aqui.
    // Fijadas por DIGEST, no por etiqueta. `bookworm-curl` y `3.12.7-slim` se
    // reconstruyen cada pocos dias con los mismos nombres: una etiqueta que
    // cambia de contenido no es una version fijada, solo lo parece. El digest
    // es inmutable.
    //
    // buildpack-deps:bookworm-curl (2026-09-19) — imagen oficial con curl sobre
    // Debian. Se cambio desde debian:12.11-slim, que son 28 MB y NO trae curl:
    // el perfil docker habria fallado en el primer uso con "curl: not found",
    // y nadie lo habia ejercitado nunca.
    container_fetch   = 'docker.io/library/buildpack-deps@sha256:5135e67ffae6dc97b3d17d6d5b2b64bff157327afb8c8c3a19d0bbb44ee1899d'
    // python:3.12.7-slim (2026-09-19)
    container_python  = 'docker.io/library/python@sha256:60d9996b6a8a3689d36db740b49f4327be3be09a21122bd02fb8895abb38b50d'
    container_fastp   = 'quay.io/biocontainers/fastp:0.24.0--heae3180_1'
    container_kraken2 = 'quay.io/biocontainers/kraken2:2.1.3--pl5321hdcf5f25_0'
    container_multiqc = 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0'

    conda_fetch   = 'conda-forge::curl=8.22.0 conda-forge::coreutils=9.12'
    conda_python  = 'conda-forge::python=3.12.7'
    conda_fastp   = 'bioconda::fastp=0.24.0'
    conda_kraken2 = 'bioconda::kraken2=2.1.3'
    conda_multiqc = 'bioconda::multiqc=1.25.1'

    // --- base de referencia: fijada y con checksum ---------------------------
    // Coleccion 16S de kraken2 (SILVA 138, congelada el 2020-03-26). El md5 NO
    // lo publica el proveedor: esta calculado en local el 2026-09-22 sobre la
    // descarga, y fijado aqui como afirmacion fechada. Ver el README.
    kraken_db_url = 'https://genome-idx.s3.amazonaws.com/kraken/16S_Silva138_20200326.tgz'
    kraken_db_md5 = '94ecb2c851f3e4f02335559d42013f0f'
    kraken_db_dir = '16S_SILVA138_k2db'

    // --- operativa -----------------------------------------------------------
    fetch_timeout   = 1800   // segundos por fichero
    fetch_retries   = 3
}

process {
    cpus   = 1
    memory = 2.GB
    time   = 2.h

    errorStrategy = 'terminate'   // una guarda que falla NO se reintenta

    withName: FETCH_READS     { cpus = 1; memory = 1.GB }
    withName: FETCH_KRAKEN_DB { cpus = 1; memory = 1.GB }
    withName: FASTP           { cpus = 2; memory = 2.GB }
    withName: QUALITY_GATE    { cpus = 1; memory = 512.MB }
    withName: KRAKEN2         { cpus = 2; memory = 4.GB }
    withName: MULTIQC         { cpus = 1; memory = 2.GB }
    withName: GATE_SUMMARY    { cpus = 1; memory = 512.MB }
    withName: PROVENANCE      { cpus = 1; memory = 512.MB }
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        conda.enabled        = false
    }
    conda {
        conda.enabled        = true
        conda.channels       = ['conda-forge', 'bioconda']
        docker.enabled       = false
    }
}
