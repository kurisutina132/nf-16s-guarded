/*
 * Perfil que corre en CI. Es tambien el que demuestra que el repositorio
 * funciona en un clon limpio: no depende de nada que solo exista en mi maquina.
 */

params {
    samplesheet   = "${projectDir}/assets/samplesheet.csv"
    outdir        = 'results'
    etapa         = 'completa'
    reference_dir = "${projectDir}/references"

    // Umbral de la puerta de calidad, en PARES de lecturas que sobreviven a
    // fastp. Las dos muestras del samplesheet traen 74.651 y 96.928 pares
    // segun ENA, asi que 50.000 las deja pasar y deja margen para el recorte.
    min_reads   = 50000

    // fastp: Q20 por base y 100 pb minimos tras el recorte. Las lecturas son
    // de 251 pb (37.474.802 bases / 74.651 pares / 2), asi que 100 recorta de
    // verdad sin tirar el amplicon.
    fastp_min_length  = 100
    fastp_min_quality = 20

    // kraken2: el defecto del programa es 0, que acepta cualquier asignacion
    // con un solo k-mero coincidente. Aqui se declara un valor no permisivo.
    kraken_confidence = 0.1
}

process {
    cpus   = 2
    memory = 4.GB
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
